# Local dev MUST point at the Neon "dev" branch, NOT "main" (main = production,
# used by Vercel). The dev branch is an isolated copy-on-write clone, so local
# work and test scripts can't touch real data. `npm run db:which` shows which
# branch you're on. Only switch to main for a deliberate prod migration.
#
# Pooled connection string (used at runtime)
DATABASE_URL="postgresql://user:password@ep-<dev-branch>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (non-pooled) connection string (used only by prisma migrate)
DIRECT_URL="postgresql://user:password@ep-<dev-branch>.<region>.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 (S3-compatible object storage) — every uploaded file (vehicle/
# model photos, blog/campaign/location images, vehicle documents, contract
# pickup/return photos) goes here. Chosen over Vercel Blob for zero egress
# fees, since contract photos add up on every rental, not just once per
# vehicle. Create the bucket + an API token with Object Read & Write scoped to
# it under Cloudflare dashboard > R2 > Manage R2 API Tokens.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="rentwin-storage"
# The bucket's public read URL — its r2.dev Public Development URL, or a
# custom domain bound to it (Settings > Public access). No trailing slash.
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# Private bucket for customer documents, vehicle records, invoice PDFs, and
# contract handover/return photos. Do not enable public access on this bucket.
R2_PRIVATE_BUCKET="rentwin-private"

# Anthropic (Claude) API key — used for "Ruhsattan Doldur" / "Belgeden Doldur"
# / "Poliçeden Doldur" (document vision extraction). Get one at
# console.anthropic.com (separate from any Claude.ai / Claude Code subscription
# — pay-as-you-go billing).
ANTHROPIC_API_KEY=""
# Optional override for the vision model (default: claude-haiku-4-5)
CLAUDE_VISION_MODEL=""

# Google Gemini API key — used for vehicle image generation and document
# extraction. Documents selected for extraction are sent to Google's Gemini API.
GEMINI_API_KEY=""
# Optional override for the image model (default: gemini-3.1-flash-image)
GEMINI_IMAGE_MODEL=""
# Optional override for document extraction (default: gemini-3.8-flash)
GEMINI_DOCUMENT_MODEL=""

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Local dev only
PORT=4000

# Consumed only by prisma/seed.js to bootstrap the first admin account
SEED_ADMIN_EMAIL="admin@rentwin.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_FIRST_NAME="System"
SEED_ADMIN_LAST_NAME="Admin"
SEED_ADMIN_PHONE="0000000000"
SEED_ADMIN_ADDRESS="N/A"
SEED_ADMIN_ZIP="00000"

# Google Search Console CLI (`npm run gsc -- help`, scripts/search-console.js).
# Path to the service account's JSON key — keep it OUTSIDE the repo.
# Default: ~/.rentwin/gsc-service-account.json
GSC_CREDENTIALS=
# Optional: pin the property ("sc-domain:rentwin.com.tr" or
# "https://rentwin.com.tr/"); otherwise it's picked by host automatically.
GSC_SITE_URL=

# GPS takip (docs/gps-takip-yol-haritasi.md). Traccar runs on our own VPS in
# Türkiye; Rentwin reads positions from it on demand and never stores
# coordinates. Leave empty until the server exists — the admin map then shows
# "GPS sunucusu ayarlanmadı".
# Local development: `node scripts/traccar-sim.js` serves simulated vehicles at
# http://localhost:8082 (see the script header for the matching values).
TRACCAR_URL=
# Token of the Traccar service user (Traccar → Ayarlar → Tercihler → Token)
TRACCAR_TOKEN=
# Shared secret Traccar sends as "Authorization: Bearer <secret>" with every
# forwarded event (event.forward.header in traccar.xml). The GPS server's
# 5-minute timer sends the same secret to POST /api/telematics/tick.
TELEMATICS_WEBHOOK_SECRET=

# Outgoing e-mail (GPS alerts). Leave empty: alerts then only show in the
# admin panel. Port 587 uses STARTTLS; set SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "Rentwin GPS <bildirim@rentwin.com.tr>"
MAIL_FROM=
