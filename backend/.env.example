# Pooled Postgres connection string (used at runtime)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection string (used only by prisma migrate)
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Vercel Blob store token (from the linked Blob store in the Vercel project)
BLOB_READ_WRITE_TOKEN=""

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Local dev only
PORT=4000

# Consumed only by prisma/seed.js to bootstrap the first admin account
SEED_ADMIN_EMAIL="admin@pickanddrive.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_FIRST_NAME="System"
SEED_ADMIN_LAST_NAME="Admin"
SEED_ADMIN_PHONE="0000000000"
SEED_ADMIN_ADDRESS="N/A"
SEED_ADMIN_ZIP="00000"
