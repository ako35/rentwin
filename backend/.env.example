# Local dev MUST point at the Neon "dev" branch, NOT "main" (main = production,
# used by Vercel). The dev branch is an isolated copy-on-write clone, so local
# work and test scripts can't touch real data. `npm run db:which` shows which
# branch you're on. Only switch to main for a deliberate prod migration.
#
# Pooled connection string (used at runtime)
DATABASE_URL="postgresql://user:password@ep-<dev-branch>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (non-pooled) connection string (used only by prisma migrate)
DIRECT_URL="postgresql://user:password@ep-<dev-branch>.<region>.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Vercel Blob store token (from the linked Blob store in the Vercel project)
BLOB_READ_WRITE_TOKEN=""

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Local dev only
PORT=4000

# Consumed only by prisma/seed.js to bootstrap the first admin account
SEED_ADMIN_EMAIL="admin@rentwin.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_FIRST_NAME="System"
SEED_ADMIN_LAST_NAME="Admin"
SEED_ADMIN_PHONE="0000000000"
SEED_ADMIN_ADDRESS="N/A"
SEED_ADMIN_ZIP="00000"
