datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Customer
  Administrator
}

enum Transmission {
  Manual
  SemiAutomatic
  Automatic
}

enum FuelType {
  Diesel
  Gasoline
  Hybrid
  Electricity
  LPG
  CNG
  Hydrogen
}

enum ContractStatus {
  CREATED
  CANCELLED
  DONE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CONVERTED
}

enum InsuranceType {
  Traffic
  Kasko
}

enum MaintenanceType {
  Periodic
  Repair
  Tire
  Other
}

enum InspectionType {
  Periodic
  Emission
}

enum InspectionResult {
  Pass
  Fail
  Defective
}

model User {
  id                 String        @id @default(uuid())
  firstName          String
  lastName           String
  email              String
  passwordHash       String
  phoneNumber        String
  address            String
  zipCode            String
  roles              Role[]        @default([Customer])
  builtIn            Boolean       @default(false)
  customerType       String        @default("Bireysel")
  customerCode       String?       @unique
  companyTitle       String?
  taxOffice          String?
  nationalId         String?
  city               String?
  district           String?
  active             Boolean       @default(true)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  reservations       Reservation[] @relation("ReservationCustomer")
  contracts          Contract[]    @relation("ContractCustomer")
  referenceContracts Contract[]    @relation("ContractReferenceCustomer")
}

model VehicleImage {
  id        String   @id @default(cuid())
  blobUrl   String
  pathname  String
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Vehicle {
  id                   String               @id @default(uuid())
  brand                String
  model                String
  licensePlate         String               @unique
  transmission         Transmission
  fuelType             FuelType
  outOfService         Boolean              @default(false)
  builtIn              Boolean              @default(false)
  branchId             String?
  branch               Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  nextMaintenanceDate  DateTime?
  nextInspectionDate   DateTime?
  modelYear            Int?
  chassisNo            String?
  engineNo             String?
  currentKm            Int?
  registrationSerialNo String?
  registrationDate     DateTime?
  color                String?
  notes                String?
  images               VehicleImage[]
  reservations         Reservation[]
  contracts            Contract[]
  insurances           VehicleInsurance[]
  taxes                VehicleTax[]
  maintenances         VehicleMaintenance[]
  inspections          VehicleInspection[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model VehicleInsurance {
  id        String        @id @default(uuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      InsuranceType
  company   String
  policyNo  String
  startDate DateTime
  endDate   DateTime
  premium   Float?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model VehicleTax {
  id          String    @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  period      Int
  installment Int
  amount      Float
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model VehicleMaintenance {
  id           String          @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type         MaintenanceType @default(Periodic)
  date         DateTime
  odometer     Int?
  vendor       String?
  description  String
  cost         Float?
  nextDate     DateTime?
  nextOdometer Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model VehicleInspection {
  id         String           @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       InspectionType   @default(Periodic)
  date       DateTime
  result     InspectionResult @default(Pass)
  expiryDate DateTime?
  station    String?
  cost       Float?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Branch {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  builtIn   Boolean   @default(false)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A lightweight booking: a car held for a customer for a date range. Created
// online by customers (status PENDING) or by staff, then optionally converted
// into a Contract when the car is handed over.
model Reservation {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("ReservationCustomer", fields: [userId], references: [id])
  carId           String
  car             Vehicle           @relation(fields: [carId], references: [id], onDelete: Restrict)
  pickUpLocation  String
  dropOffLocation String
  pickUpTime      DateTime
  dropOffTime     DateTime
  status          ReservationStatus @default(PENDING)
  note            String?
  contract        Contract?         @relation("ContractFromReservation")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// The full rental agreement — pricing, extras, drivers, payments, invoice.
// May be created directly (walk-in) or converted from a Reservation.
model Contract {
  id                String              @id @default(uuid())
  pickUpLocation    String
  dropOffLocation   String
  pickUpTime        DateTime
  dropOffTime       DateTime
  totalPrice        Float
  status            ContractStatus      @default(CREATED)
  userId            String
  user              User                @relation("ContractCustomer", fields: [userId], references: [id])
  referenceUserId   String?
  referenceUser     User?               @relation("ContractReferenceCustomer", fields: [referenceUserId], references: [id], onDelete: SetNull)
  carId             String
  car               Vehicle             @relation(fields: [carId], references: [id], onDelete: Restrict)
  corporateId       String?
  corporate         Corporate?          @relation(fields: [corporateId], references: [id], onDelete: SetNull)
  reservationId     String?             @unique
  reservation       Reservation?        @relation("ContractFromReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  customerNote      String?
  adminNote         String?
  referenceNo       String?
  flightNo          String?
  dailyPrice        Float?
  extrasTotal       Float?
  oneWayFee         Float?
  discount          Float?
  discountIsPercent Boolean             @default(false)
  discountDailyOnly Boolean             @default(true)
  deposit           Float?
  returnExtraAmount Float?
  kmLimit           Int?
  unlimitedKm       Boolean             @default(true)
  vatRate           Float               @default(20)
  drivers           ContractDriver[]
  payments          ContractPayment[]
  extras            ContractExtra[]
  extensions        ContractExtension[]
  invoice           Invoice?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

// A contract extension: pushes the drop-off out and adds an amount.
model ContractExtension {
  id              String   @id @default(uuid())
  contractId      String
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  previousDropOff DateTime
  newDropOff      DateTime
  extraDays       Int      @default(0)
  extraAmount     Float    @default(0)
  note            String?
  createdAt       DateTime @default(now())
}

// One invoice per contract, numbered per year.
model Invoice {
  id            String   @id @default(uuid())
  contractId    String   @unique
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number        String   @unique
  issuedAt      DateTime @default(now())
  netAmount     Float    @default(0)
  taxAmount     Float    @default(0)
  grossAmount   Float    @default(0)
  customerTitle String?
  taxNo         String?
  note          String?
  createdAt     DateTime @default(now())
}

// Additional named drivers on a rental contract.
model ContractDriver {
  id          String    @id @default(uuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  licenseNo   String?
  licenseDate DateTime?
  birthDate   DateTime?
  phone       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContractPayment {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount     Float
  method     String   @default("Cash")
  paidAt     DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Catalogue of billable extras (child seat, extra driver, GPS, ...).
model Extra {
  id        String   @id @default(uuid())
  name      String
  unitPrice Float    @default(0)
  perDay    Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An extra selected on a specific contract (values snapshotted from the catalogue).
model ContractExtra {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name       String
  unitPrice  Float    @default(0)
  perDay     Boolean  @default(true)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// "Cari" — corporate customer a contract can be billed to.
model Corporate {
  id          String     @id @default(uuid())
  title       String
  taxOffice   String?
  taxNo       String?
  phone       String?
  email       String?
  note        String?
  blacklisted Boolean    @default(false)
  contracts   Contract[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  body      String
  createdAt DateTime @default(now())
}
