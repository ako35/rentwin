datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Customer
  Administrator
}

enum Transmission {
  Manual
  SemiAutomatic
  Automatic
}

enum FuelType {
  Diesel
  Gasoline
  Hybrid
  Electricity
  LPG
  CNG
  Hydrogen
}

// Picks which four-view line drawing prints on the Araç Teslim/İade Tutanağı
// (see frontend VehicleDiagram.jsx) — not used for pricing/search.
enum VehicleBodyType {
  BINEK // sedan / hatchback — the default, existing generic diagram
  SUV
  PANELVAN_MINIBUS
  KAMYONET
}

enum ContractStatus {
  CREATED
  CANCELLED
  DONE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CONVERTED
}

enum InsuranceType {
  Traffic
  Kasko
}

enum MaintenanceType {
  Periodic
  Repair
  Tire
  Other
}

enum InspectionType {
  Periodic
  Emission
}

enum InspectionResult {
  Pass
  Fail
  Defective
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerSource {
  MANUAL
  AUTO_CONTRACT
  AUTO_PAYMENT
}

enum LedgerCategory {
  RENTAL
  EXTRA
  TRAFFIC_FINE
  DAMAGE
  FUEL
  MANUAL_DEBIT
  PAYMENT
  REFUND
  DISCOUNT
  MANUAL_CREDIT
}

model User {
  id                 String        @id @default(uuid())
  firstName          String
  lastName           String
  email              String
  passwordHash       String
  phoneNumber        String
  address            String
  zipCode            String
  roles              Role[]        @default([Customer])
  builtIn            Boolean       @default(false)
  customerType       String        @default("Bireysel")
  customerCode       String?       @unique
  companyTitle       String?
  taxOffice          String?
  nationalId         String?
  city               String?
  district           String?
  active             Boolean       @default(true)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  reservations       Reservation[] @relation("ReservationCustomer")
  contracts          Contract[]    @relation("ContractCustomer")
  referenceContracts Contract[]    @relation("ContractReferenceCustomer")
  ledgerEntries      LedgerEntry[] @relation("UserLedger")
}

model VehicleImage {
  id        String   @id @default(cuid())
  blobUrl   String
  pathname  String
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// A catalog image per make+model, optionally per colour too. brand/model/color
// are stored normalized (trim + TR-uppercase); year is irrelevant. color=""
// is the generic/no-colour-specific image — every vehicle of that make+model
// falls back to it when no image exists for its own exact colour.
model VehicleModelImage {
  id        String   @id @default(uuid())
  brand     String
  model     String
  color     String   @default("")
  blobUrl   String
  pathname  String
  source    String   @default("UPLOAD") // UPLOAD | AI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, model, color])
}

model Vehicle {
  id                   String               @id @default(uuid())
  brand                String
  model                String
  licensePlate         String               @unique
  transmission         Transmission
  fuelType             FuelType
  bodyType             VehicleBodyType      @default(BINEK)
  outOfService         Boolean              @default(false)
  builtIn              Boolean              @default(false)
  soldAt               DateTime? // set = vehicle sold and retired from the fleet; auto-purged 5 years later
  saleNote             String? // free-text note captured at sale time
  branchId             String?
  branch               Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  nextMaintenanceDate  DateTime?
  nextInspectionDate   DateTime?
  maintenanceIntervalKm Int? // periodic maintenance km interval the operator plans around, e.g. 10000
  nextMaintenanceKm    Int? // synced from the latest logged maintenance record's planned "next odometer"
  modelYear            Int?
  chassisNo            String?
  engineNo             String?
  currentKm            Int?
  currentFuelPercent   Int? // deprecated — replaced by currentFuelEighths; kept nullable until a later cleanup migration
  currentFuelEighths   Int? // fuel / charge gauge reading, 0-8
  registrationSerialNo String?
  registrationDate     DateTime?
  color                String?
  notes                String?
  images               VehicleImage[]
  reservations         Reservation[]
  contracts            Contract[]
  insurances           VehicleInsurance[]
  taxes                VehicleTax[]
  maintenances         VehicleMaintenance[]
  inspections          VehicleInspection[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model VehicleInsurance {
  id        String        @id @default(uuid())
  vehicleId String
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      InsuranceType
  company   String
  policyNo  String
  startDate DateTime
  endDate   DateTime
  premium   Float?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model VehicleTax {
  id          String    @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  period      Int
  installment Int
  amount      Float?
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model VehicleMaintenance {
  id           String          @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type         MaintenanceType @default(Periodic)
  date         DateTime
  odometer     Int?
  vendor       String?
  description  String
  cost         Float?
  nextDate     DateTime?
  nextOdometer Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model VehicleInspection {
  id         String           @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       InspectionType   @default(Periodic)
  date       DateTime
  result     InspectionResult @default(Pass)
  expiryDate DateTime?
  station    String?
  cost       Float?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Branch {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  builtIn   Boolean   @default(false)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Pick-up/drop-off location options offered on booking/contract forms —
// intentionally separate from Branch (a branch owns vehicles; a location is
// just a place name a customer can pick for hand-over).
model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  imageId   String? // orphan VehicleImage.id used as a generic blob store (see modules/files)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A public-facing promotion shown on the homepage and the /kampanyalar page.
// startsAt/endsAt are display-only ("valid between …"); `active` is the only
// visibility gate. imageId is an orphan VehicleImage.id, same generic blob
// store Location uses.
model Campaign {
  id          String    @id @default(uuid())
  title       String
  description String
  imageId     String?
  ctaLabel    String?
  ctaUrl      String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A public blog post (SEO content marketing) with a persisted slug — unlike
// Location's on-the-fly slugify(name), the slug here is stored so it survives
// title edits. `content` is HTML from the admin's rich-text editor; only an
// authenticated admin can write it (see requireAdmin on the /blog/admin/*
// routes), so it's rendered on the frontend without sanitization.
model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  imageId     String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A lightweight booking: a car held for a customer for a date range. Created
// online by customers (status PENDING) or by staff, then optionally converted
// into a Contract when the car is handed over.
model Reservation {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("ReservationCustomer", fields: [userId], references: [id])
  carId           String
  car             Vehicle           @relation(fields: [carId], references: [id], onDelete: Restrict)
  pickUpLocation  String
  dropOffLocation String
  pickUpTime      DateTime
  dropOffTime     DateTime
  status          ReservationStatus @default(PENDING)
  note            String?
  contract        Contract?         @relation("ContractFromReservation")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// The full rental agreement — pricing, extras, drivers, payments, invoice.
// May be created directly (walk-in) or converted from a Reservation.
model Contract {
  id                String              @id @default(uuid())
  contractNo        String?             @unique
  pickUpLocation    String
  dropOffLocation   String
  pickUpTime        DateTime
  dropOffTime       DateTime
  totalPrice        Float
  status            ContractStatus      @default(CREATED)
  userId            String
  user              User                @relation("ContractCustomer", fields: [userId], references: [id])
  referenceUserId   String?
  referenceUser     User?               @relation("ContractReferenceCustomer", fields: [referenceUserId], references: [id], onDelete: SetNull)
  carId             String
  car               Vehicle             @relation(fields: [carId], references: [id], onDelete: Restrict)
  corporateId       String?
  corporate         Corporate?          @relation(fields: [corporateId], references: [id], onDelete: SetNull)
  reservationId     String?             @unique
  reservation       Reservation?        @relation("ContractFromReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  customerNote      String?
  adminNote         String?
  adminNoteAt       DateTime? // when adminNote was last written/changed, stamped server-side
  adminNoteBy       String? // display name of the admin who last wrote it
  referenceNo       String?
  flightNo          String?
  pickUpKm          Int? // odometer at hand-over (prefilled from the vehicle, editable)
  pickUpFuelEighths Int? // fuel / charge gauge at hand-over, 0-8
  returnKm          Int? // odometer at return (set by the vehicle-return flow)
  returnFuelEighths Int? // fuel / charge gauge at return, 0-8
  returnedAt        DateTime? // when the vehicle-return was processed
  rentalType        String              @default("DAILY") // "DAILY" | "MONTHLY" — drives the rental-amount formula
  dailyPrice        Float? // used when rentalType = DAILY
  monthlyPrice      Float? // used when rentalType = MONTHLY (30-day fixed month + prorated days)
  extrasTotal       Float?
  oneWayFee         Float?
  discount          Float?
  discountIsPercent Boolean             @default(false)
  discountDailyOnly Boolean             @default(true)
  deposit           Float?
  returnExtraAmount Float?
  kmLimit           Int? // legacy single total-km allowance; superseded by daily/monthly below
  dailyKmLimit      Int? // km allowance per rental day
  monthlyKmLimit    Int? // km allowance per 30-day month
  kmOverageFee      Float? // TL charged per excess km at return
  fuelFeePerEighth  Float? // TL charged per missing 1/8 tank at return
  unlimitedKm       Boolean             @default(true)
  vatRate           Float               @default(20)
  kbsNotifiedAt     DateTime? // when the rental was filed in KABİS (Kimlik Bildirme Sistemi); null = not filed
  kbsNotifiedBy     String? // display name of the admin who filed it, stamped on the null -> set transition
  kbsReleasedAt     DateTime? // when the KABİS record was released (çıkış); requires kbsNotifiedAt to be set
  kbsReleasedBy     String? // display name of the admin who released it, stamped on the null -> set transition
  kbsSystem         String? // which of the two KABİS portals (name snapshot from Setting) this rental was filed under; null until filed
  hgsStatus         String? // DERIVED, never set by hand: "CHECKED" once hgsChecks ranges span the whole rental, else null (see contract-records.syncHgsStatus)
  hgsChecks         ContractHgsCheck[] // one row per queried date range (the audit log)
  hgsCheckedAt      DateTime? // DEPRECATED — superseded by ContractHgsCheck rows
  hgsCheckedBy      String? // DEPRECATED
  hgsNote           String? // DEPRECATED
  hgsCheckedFrom    DateTime? // DEPRECATED
  hgsCheckedTo      DateTime? // DEPRECATED
  hgsAmount         Float? // DEPRECATED — toll amounts live on the Dönüş Ekstra tab
  hgsReflected      Boolean             @default(false) // DEPRECATED
  drivers           ContractDriver[]
  payments          ContractPayment[]
  extras            ContractExtra[]
  returnCharges     ContractReturnCharge[]
  extensions        ContractExtension[]
  vehicleChanges    ContractVehicleChange[]
  invoices          Invoice[]
  ledgerEntries     LedgerEntry[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

// A contract extension: pushes the drop-off out and adds an operator-entered
// amount to the contract total. Each extension is an independent flat line —
// nothing is re-priced. `extraAmountNet` is what the operator typed; `extraAmount`
// is the gross that hits the balance (MONTHLY: net * (1 + vatRate/100); DAILY:
// net, VAT-inclusive). Deletable — see contracts.controller.deleteExtension.
model ContractExtension {
  id              String   @id @default(uuid())
  contractId      String
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  previousDropOff DateTime
  newDropOff      DateTime
  extraDays       Int      @default(0)
  months          Int      @default(0) // whole months the extension spans (min 1 for MONTHLY)
  extraAmount     Float    @default(0) // gross — added to Contract.totalPrice
  extraAmountNet  Float? // the net figure the operator entered
  note            String?
  createdAt       DateTime @default(now())
}

// A mid-contract vehicle swap. Car labels are a point-in-time snapshot
// (brand/model/plate) so history reads correctly even if the vehicle is later
// edited or removed; no FK to Vehicle is needed for that reason.
model ContractVehicleChange {
  id                String   @id @default(uuid())
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changeDate        DateTime
  previousCarId     String
  previousCarLabel  String
  returnKm          Int? // previous car's odometer at hand-back
  returnFuelEighths Int? // previous car's fuel / charge gauge at hand-back, 0-8
  newCarId          String
  newCarLabel       String
  newCarKm          Int? // new car's odometer at hand-over (prefilled from the vehicle, editable)
  newCarFuelEighths Int? // new car's fuel / charge gauge at hand-over, 0-8
  note              String?
  createdAt         DateTime @default(now())
}

// Invoices raised against a contract. A contract can have several (partial
// invoices, corrections, extra charges billed separately). Numbers are globally
// unique, auto-assigned RW-YYYY-NNNNN when the operator leaves the field blank.
model Invoice {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number        String   @unique
  issuedAt      DateTime @default(now())
  periodFrom    DateTime? // billing period this invoice covers (e.g. one month of a monthly rental)
  periodTo      DateTime?
  netAmount     Float    @default(0)
  taxAmount     Float    @default(0)
  grossAmount   Float    @default(0)
  customerTitle String?
  taxNo         String?
  note          String?
  createdAt     DateTime @default(now())
}

// Additional named drivers on a rental contract.
model ContractDriver {
  id          String    @id @default(uuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  nationalId  String?
  licenseDate DateTime?
  birthDate   DateTime?
  phone       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContractPayment {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount     Float
  method     String   @default("Cash")
  paidAt     DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Double-entry current-account ledger. One row per debit/credit movement on a
// customer (User) account. Contract grand totals and contract payments are
// mirrored here (source AUTO_*) and kept in sync from the contract flow;
// everything else (traffic fines, damage, manual charges, off-contract
// collections) is entered by hand (source MANUAL). The running balance is
// computed at read time, never stored.
model LedgerEntry {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation("UserLedger", fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime        @default(now())
  direction         LedgerDirection
  category          LedgerCategory
  amount            Float
  description       String?
  method            String?
  contractId        String?
  contract          Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractNo        String? // snapshot of contract.contractNo — survives the contract being purged with a sold vehicle
  contractPaymentId String?         @unique
  invoiceNo         String?
  source            LedgerSource    @default(MANUAL)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, date])
}

// Catalogue of billable extras (child seat, extra driver, GPS, ...).
model Extra {
  id        String   @id @default(uuid())
  name      String
  unitPrice Float    @default(0)
  perDay    Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An extra selected on a specific contract (values snapshotted from the catalogue).
model ContractExtra {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name       String
  unitPrice  Float    @default(0)
  perDay     Boolean  @default(true)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A return-time charge itemised on the contract (HGS/OGS, km excess, damage,
// roadside, cleaning, fuel difference, other). The summed line totals are cached
// on Contract.returnExtraAmount, which feeds the grand total.
// Audit log for the HGS/OGS toll check: one row per date range queried on the
// HGS portal. `checkedBy` + `createdAt` = who ran that query and when.
model ContractHgsCheck {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rangeFrom  DateTime
  rangeTo    DateTime
  note       String?
  checkedBy  String? // staff display name, stamped server-side on create
  createdAt  DateTime @default(now())

  @@index([contractId])
}

model ContractReturnCharge {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  category      String // HGS_OGS | KM_EXCESS | DAMAGE | ROADSIDE | CLEANING | FUEL | DEPOSIT | OTHER
  description   String?
  amount        Float    @default(0)
  quantity      Int      @default(1)
  periodFrom    DateTime? // HGS_OGS: first travel date the reflected toll covers
  periodTo      DateTime? // HGS_OGS: last travel date the reflected toll covers
  applyVat      Boolean  @default(false) // true = amount is net, VAT (at the contract's vatRate) is added on top when reflected in the total
  autoGenerated Boolean  @default(false) // true = created by an auto-sync flow (RETURN or HGS)
  source        String   @default("MANUAL") // MANUAL | RETURN (return-modal km/fuel) | HGS (toll check)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contractId])
}

// "Cari" — corporate customer a contract can be billed to.
model Corporate {
  id          String     @id @default(uuid())
  title       String
  taxOffice   String?
  taxNo       String?
  phone       String?
  email       String?
  note        String?
  blacklisted Boolean    @default(false)
  contracts   Contract[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  body      String
  createdAt DateTime @default(now())
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Public customer reviews (star rating + text). Visitor-submitted, admin-
// moderated: stays PENDING until an admin approves/rejects it — only
// APPROVED reviews are ever shown on the public site or fed into the
// homepage's AggregateRating JSON-LD (see backend/src/lib/seo-ld.js
// autoRentalLd). `name` is stored raw; every PUBLIC read masks it to
// "Ayşe Y." (backend/src/modules/reviews/reviews.shared.js maskName) — the
// admin moderation queue sees the full name.
model Review {
  id          String       @id @default(uuid())
  name        String
  rating      Int
  body        String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  moderatedAt DateTime?

  @@index([status, createdAt])
}

// App-wide settings. Single row, id fixed to "singleton" — always upserted.
model Setting {
  id                      String   @id @default("singleton")
  defaultDailyKmLimit     Int?
  defaultMonthlyKmLimit   Int?
  defaultKmOverageFee     Float?
  defaultFuelFeePerEighth Float?
  updatedAt               DateTime @updatedAt
}

// Operator-managed list of KABİS (Kimlik Bildirme Sistemi) portals — add/
// delete from Ayarlar, no fixed count. Referenced by name (not FK) from
// Contract.kbsSystem, a snapshot taken when the rental was filed, so
// renaming or deleting an entry here never touches past contracts.
model KabisSystem {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Informational counter for the shared Gemini vision free-tier quota —
// "Ruhsattan Doldur" and "Belgeden Doldur" both call the same model on the
// same API key/project, so they draw from one daily pool. id is a fixed key
// per tracked model (currently just "vision"); day is the Google quota-reset
// calendar date (Pacific Time) as "YYYY-MM-DD". count is how many calls have
// actually gone out today — a retried call can cost Google more than the 1
// counted here, so it's a floor, not exact. exhaustedAt is null until
// Google's own 429 is actually hit that day, then holds the count it
// happened at — deliberately NOT a guessed daily limit (Google doesn't
// publish one for this tier), just the one fact about the quota we can ever
// be sure of because we watched it happen.
model AiUsageCounter {
  id          String   @id
  day         String
  count       Int      @default(0)
  exhaustedAt Int?
  updatedAt   DateTime @updatedAt
}
