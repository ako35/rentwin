{
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "backend/api/index.js", "use": "@vercel/node" }
  ],
  "crons": [
    { "path": "/api/cron/purge-sold-vehicles", "schedule": "0 3 * * *" }
  ],
  "routes": [
    {
      "src": "/araclar/ford-transit/?",
      "status": 301,
      "dest": "/vehicles/4bd9e816-44af-462f-a178-c79111cca207"
    },
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "src": "/sitemap.xml", "dest": "backend/api/index.js" },
    {
      "src": "/((en/)?(vehicles/[^/]+|lokasyonlar/[^/]+|blog/[^/]+|vehicles|lokasyonlar|blog|kampanyalar|yorumlar|about|contact|sss|privacy-policy)|en)/?",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|facebookexternalhit|WhatsApp|Twitterbot|Slackbot|LinkedInBot|TelegramBot|Discordbot|Applebot|Pinterest|Embedly|Googlebot|Google-InspectionTool|bingbot|BingPreview|YandexBot|Baiduspider|DuckDuckBot|GPTBot|ChatGPT|OAI-SearchBot|ClaudeBot|Claude-Web|PerplexityBot|Amazonbot|redditbot|vkShare|SkypeUriPreview).*"
        }
      ],
      "dest": "backend/api/index.js"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|facebookexternalhit|WhatsApp|Twitterbot|Slackbot|LinkedInBot|TelegramBot|Discordbot|Applebot|Pinterest|Embedly|Googlebot|Google-InspectionTool|bingbot|BingPreview|YandexBot|Baiduspider|DuckDuckBot|GPTBot|ChatGPT|OAI-SearchBot|ClaudeBot|Claude-Web|PerplexityBot|Amazonbot|redditbot|vkShare|SkypeUriPreview).*"
        }
      ],
      "dest": "backend/api/index.js"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
