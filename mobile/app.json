{
  "expo": {
    "name": "Rentwin Saha",
    "slug": "mobile",
    "scheme": "rentwinstaff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rentwin.saha",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Araç teslim/iade fotoğrafı çekmek için kameraya erişim gerekiyor."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://rentwin.com.tr/api"
    }
  }
}
