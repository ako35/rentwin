# Bu servisin kendi portu (VPS üzerinde pm2/nginx bu porta yönlendirir).
PORT=4100

# Rentwin backend (Vercel) buraya istek atarken bu değeri
# "Authorization: Bearer <secret>" header'ında gönderir. Uzun/rastgele bir
# değer üretin (örn. `openssl rand -hex 32`) ve aynısını Vercel tarafında
# KABIS_PROXY_SHARED_SECRET olarak tanımlayın.
KABIS_PROXY_SHARED_SECRET=

# Sadece Rentwin backend'in bu servise erişebilmesi için CORS/istek kaynağı
# kısıtlaması (tarayıcıdan değil, sunucudan sunucuya çağrıldığı için
# genelde gerekmez ama healthcheck/manuel test için faydalı).
ALLOWED_ORIGIN=https://rentwin.com.tr

# ---- Aşağıdakiler EGM'den KABİS entegrasyon başvurusu sonucunda gelecek.
# ---- Doküman/erişim elimize geçmeden bu servis KABİS'e gerçek bir istek
# ---- ATMAZ (src/kabis-client.js şu an kasıtlı olarak "not implemented").
KABIS_BASE_URL=
KABIS_USERNAME=
KABIS_PASSWORD=
KABIS_KURUM_KODU=
